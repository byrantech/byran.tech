<!doctype html>
<script>
	document.addEventListener("DOMContentLoaded", () => {
		const buttons = document.querySelectorAll("span.clickable");
		buttons.forEach((button) => {
			button.addEventListener("click", () => {
				const targetElement = document.getElementById(`${button.id}_target`);
				targetElement?.scrollIntoView({ behavior: "smooth", block: "start" });
			});
		});

		// Keep custom cursor for fine pointers only (desktop/laptops).
		if (!window.matchMedia("(pointer: fine)").matches) return;

		const cursor = document.getElementById("cursor");
		if (!cursor) return;

		let rafPending = false;
		let pendingX = 0;
		let pendingY = 0;
		document.body.addEventListener(
			"mousemove",
			(e) => {
				pendingX = e.clientX;
				pendingY = e.clientY;
				if (rafPending) return;
				rafPending = true;
				requestAnimationFrame(() => {
					rafPending = false;
					cursor.style.opacity = "1";
					const offset = cursor.classList.contains("hover") ? 30 : 27;
					cursor.style.transform = `translate(${pendingX - offset}px, ${pendingY - offset}px)`;
				});
			},
			{ passive: true }
		);

		window.addEventListener("blur", () => {
			cursor.style.display = "none";
		});
		window.addEventListener("focus", () => {
			cursor.style.display = "block";
		});

		const links = document.querySelectorAll("a, .clickable");
		for (const link of links) {
			link.addEventListener("mouseenter", () => cursor.classList.add("hover"));
			link.addEventListener("mouseleave", () => cursor.classList.remove("hover"));
		}
	});
</script>

<html lang="en">
