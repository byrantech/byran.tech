---
const today = new Date();
---

<footer class="text-neutral-400 font-[Hubot] p-5">
  &copy; {today.getFullYear()}
  <span id="copy-name"> Byran Huang</span>,
  MIT License | Open Source | Attempt the impossible.

  <script>
    const span = document.getElementById("copy-name");
    if (span) {
      span.addEventListener("click", () => {
        navigator.clipboard.writeText("Amelie Chen <3");
      });
    }
  </script>
</footer>